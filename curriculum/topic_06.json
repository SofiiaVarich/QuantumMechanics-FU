      "definition": "V is the perturbing Hamiltonian; λ controls its strength.",
      "key_rule": "H(λ) = H⁽⁰⁾ + λV",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-003",
      "section_id": "6.1",
      "front": "Perturbed spectral decomposition",
      "definition": "Target eigenvalues and eigenvectors of the perturbed problem.",
      "key_rule": "H(λ) = Σⱼ Eⱼ(λ)|ψⱼ(λ)⟩⟨ψⱼ(λ)|",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-004",
      "section_id": "6.1.1",
      "front": "Perturbed eigenvalue equation",
      "definition": "Eigenvalue problem for the perturbed Hamiltonian.",
      "key_rule": "H(λ)|ψⱼ(λ)⟩ = Eⱼ(λ)|ψⱼ(λ)⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-005",
      "section_id": "6.1.1",
      "front": "Rayleigh–Schrödinger energy series",
      "definition": "Energy expanded in powers of perturbation strength.",
      "key_rule": "Eⱼ(λ) = Σₙ₌₀∞ λⁿ Eⱼ⁽ⁿ⁾",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-006",
      "section_id": "6.1.1",
      "front": "Perturbed state expansion",
      "definition": "Eigenvector expanded in powers of λ.",
      "key_rule": "|ψⱼ(λ)⟩ = Σₙ₌₀∞ λⁿ|ψⱼ⁽ⁿ⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-007",
      "section_id": "6.1.1",
      "front": "Zeroth-order equation",
      "definition": "The original eigenvalue equation.",
      "key_rule": "(H⁽⁰⁾−Eⱼ⁽⁰⁾)|ψⱼ⁽⁰⁾⟩ = 0",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-008",
      "section_id": "6.1.1",
      "front": "First-order eigenvector equation",
      "definition": "Determines the leading correction to the state.",
      "key_rule": "(H⁽⁰⁾−Eⱼ⁽⁰⁾)|ψⱼ⁽¹⁾⟩ = (Eⱼ⁽¹⁾−V)|ψⱼ⁽⁰⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-009",
      "section_id": "6.1.1",
      "front": "Intermediate normalization",
      "definition": "Convenient choice of normalization in the derivation.",
      "key_rule": "⟨ψⱼ⁽⁰⁾|ψⱼ(λ)⟩ = 1",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-010",
      "section_id": "6.1.1",
      "front": "Higher-order orthogonality",
      "definition": "Perturbative state corrections are orthogonal to the zeroth-order state.",
      "key_rule": "⟨ψⱼ⁽⁰⁾|ψⱼ⁽ⁿ⁾⟩ = 0, n≥1",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-011",
      "section_id": "6.1.1",
      "front": "First-order energy correction",
      "definition": "Expectation value of the perturbation in the original state.",
      "key_rule": "Eⱼ⁽¹⁾ = ⟨ψⱼ⁽⁰⁾|V|ψⱼ⁽⁰⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-012",
      "section_id": "6.1.1",
      "front": "General energy correction",
      "definition": "Recursive expression for energy corrections.",
      "key_rule": "Eⱼ⁽ⁿ⁾ = ⟨ψⱼ⁽⁰⁾|V|ψⱼ⁽ⁿ⁻¹⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-013",
      "section_id": "6.1.1",
      "front": "First-order state coefficients",
      "definition": "Mixing coefficients for distinct unperturbed states.",
      "key_rule": "⟨ψₗ⁽⁰⁾|ψⱼ⁽¹⁾⟩ = ⟨ψₗ⁽⁰⁾|V|ψⱼ⁽⁰⁾⟩/(Eⱼ⁽⁰⁾−Eₗ⁽⁰⁾), l≠j",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-014",
      "section_id": "6.1.1",
      "front": "Reduced resolvent operator",
      "definition": "Operator used to compute perturbative state corrections.",
      "key_rule": "Sⱼ = Σₖ≠ⱼ |ψₖ⁽⁰⁾⟩⟨ψₖ⁽⁰⁾|/(Eⱼ⁽⁰⁾−Eₖ⁽⁰⁾)",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-015",
      "section_id": "6.1.1",
      "front": "First-order state correction",
      "definition": "Linear combination of other unperturbed eigenstates.",
      "key_rule": "|ψⱼ⁽¹⁾⟩ = Σₗ≠ⱼ [⟨ψₗ⁽⁰⁾|V|ψⱼ⁽⁰⁾⟩/(Eⱼ⁽⁰⁾−Eₗ⁽⁰⁾)]|ψₗ⁽⁰⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-016",
      "section_id": "6.1.1",
      "front": "Second-order energy correction",
      "definition": "Second-order shift from couplings to other states.",
      "key_rule": "Eⱼ⁽²⁾ = Σₗ≠ⱼ |⟨ψₗ⁽⁰⁾|V|ψⱼ⁽⁰⁾⟩|²/(Eⱼ⁽⁰⁾−Eₗ⁽⁰⁾)",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-017",
      "section_id": "6.1.1",
      "front": "Perturbation matrix elements",
      "definition": "Quantities needed to evaluate first-order corrections.",
      "key_rule": "Vₗⱼ = ⟨ψₗ⁽⁰⁾|V|ψⱼ⁽⁰⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-018",
      "section_id": "6.1.1",
      "front": "Ground-state second-order shift",
      "definition": "Second-order correction to a nondegenerate ground-state energy is non-positive.",
      "key_rule": "E₀⁽²⁾ ≤ 0",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-019",
      "section_id": "6.1.1",
      "front": "Perturbative asymptotic expansion",
      "definition": "Higher-order terms need not improve an asymptotic approximation.",
      "key_rule": "Low orders may approximate well even when the full series does not converge",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-020",
      "section_id": "6.1.2",
      "front": "Anharmonic oscillator Hamiltonian",
      "definition": "Harmonic oscillator with quartic perturbation.",
      "key_rule": "H(λ) = H⁽⁰⁾ + λX⁴",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-021",
      "section_id": "6.1.2",
      "front": "Harmonic oscillator reference Hamiltonian",
      "definition": "Exactly solvable unperturbed system.",
      "key_rule": "H⁽⁰⁾ = P²/(2m) + kX²/2",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-022",
      "section_id": "6.1.2",
      "front": "Quartic perturbation",
      "definition": "Anharmonic correction to the potential.",
      "key_rule": "V = X⁴",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-023",
      "section_id": "6.1.2",
      "front": "Anharmonic ground-state expansion",
      "definition": "Example expansion in the lecture's chosen units.",
      "key_rule": "E₀(λ) = 1 + 3λ/4 − 21λ²/16 + O(λ³)",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-024",
      "section_id": "6.1.2",
      "front": "Truncated perturbation series",
      "definition": "Approximation including terms up to order m.",
      "key_rule": "E₀(m) = Σₙ₌₀ᵐ λⁿ E₀⁽ⁿ⁾",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-025",
      "section_id": "6.1.2",
      "front": "Asymptotic high-order failure",
