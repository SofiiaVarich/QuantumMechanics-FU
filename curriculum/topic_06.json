      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-026",
      "section_id": "6.1.3",
      "front": "Degenerate unperturbed eigenspace",
      "definition": "Several eigenstates share the same unperturbed energy.",
      "key_rule": "H⁽⁰⁾|ψⱼ⁽⁰⁾⟩ = E|ψⱼ⁽⁰⁾⟩, j=1,…,s",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-027",
      "section_id": "6.1.3",
      "front": "Degenerate perturbation matrix",
      "definition": "Perturbation restricted to the degenerate subspace.",
      "key_rule": "Mₗⱼ = ⟨ψₗ⁽⁰⁾|V|ψⱼ⁽⁰⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-028",
      "section_id": "6.1.3",
      "front": "Unitary diagonalization",
      "definition": "Diagonalize the perturbation within the degenerate subspace.",
      "key_rule": "U†MU = D",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-029",
      "section_id": "6.1.3",
      "front": "Unitary matrix condition",
      "definition": "The basis change preserves orthonormality.",
      "key_rule": "UU† = U†U = 1",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-030",
      "section_id": "6.1.3",
      "front": "Degenerate basis selection",
      "definition": "Avoids zero denominators in naive nondegenerate formulas.",
      "key_rule": "Choose a basis that diagonalizes M",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-031",
      "section_id": "6.2.1",
      "front": "Time-dependent perturbed Hamiltonian",
      "definition": "Known reference Hamiltonian plus time-dependent perturbation.",
      "key_rule": "H(t) = H⁽⁰⁾ + λV(t)",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-032",
      "section_id": "6.2.1",
      "front": "Perturbation switch-on condition",
      "definition": "The perturbation begins after the initial time.",
      "key_rule": "V(t) = 0 for t≤t₀",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-033",
      "section_id": "6.2.1",
      "front": "Time-dependent Schrödinger equation",
      "definition": "Full time evolution under the perturbed Hamiltonian.",
      "key_rule": "iℏ∂ₜ|ψ(t)⟩ = [H⁽⁰⁾+λV(t)]|ψ(t)⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-034",
      "section_id": "6.2.1",
      "front": "Interaction-picture state",
      "definition": "Removes the free evolution generated by H⁽⁰⁾.",
      "key_rule": "|ψ(t)⟩ᵢ = exp(iH⁽⁰⁾t/ℏ)|ψ(t)⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-035",
      "section_id": "6.2.1",
      "front": "Interaction-picture Schrödinger equation",
      "definition": "Evolution equation driven by the interaction operator.",
      "key_rule": "iℏ∂ₜ|ψ(t)⟩ᵢ = λVᵢ(t)|ψ(t)⟩ᵢ",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-036",
      "section_id": "6.2.1",
      "front": "Interaction-picture perturbation",
      "definition": "Perturbation transformed to the interaction picture.",
      "key_rule": "Vᵢ(t) = exp(iH⁽⁰⁾t/ℏ)V(t)exp(−iH⁽⁰⁾t/ℏ)",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-037",
      "section_id": "6.2.1",
      "front": "Interaction-picture integral equation",
      "definition": "Integral form of the interaction-picture dynamics.",
      "key_rule": "|ψ(t)⟩ᵢ = |ψ(t₀)⟩ᵢ + [λ/(iℏ)]∫ₜ₀ᵗ ds Vᵢ(s)|ψ(s)⟩ᵢ",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-038",
      "section_id": "6.2.1",
      "front": "Von Neumann series",
      "definition": "Iterative expansion of the interaction-picture integral equation.",
      "key_rule": "|ψ(t)⟩ᵢ = |ψ(t₀)⟩ᵢ + O(λ) + O(λ²) + …",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-039",
      "section_id": "6.2.2",
      "front": "Free evolution of final eigenstate",
      "definition": "Time evolution of an unperturbed energy eigenstate.",
      "key_rule": "|ψₖ⁽⁰⁾(t)⟩ = exp(−iEₖ⁽⁰⁾t/ℏ)|ψₖ⁽⁰⁾⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-040",
      "section_id": "6.2.2",
      "front": "First-order transition amplitude",
      "definition": "Amplitude for a transition between unperturbed eigenstates.",
      "key_rule": "Aₖⱼ(t) = δₖⱼ + [λ/(iℏ)]∫ₜ₀ᵗ ds exp[i(Eₖ⁽⁰⁾−Eⱼ⁽⁰⁾)s/ℏ]⟨ψₖ⁽⁰⁾|V(s)|ψⱼ⁽⁰⁾⟩ + O(λ²)",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-041",
      "section_id": "6.2.2",
      "front": "Transition probability",
      "definition": "Squared magnitude of the transition amplitude.",
      "key_rule": "Pⱼₖ(t) = |⟨ψₖ⁽⁰⁾(t)|ψ(t)⟩|²",
      "source_status": "Not started",
      "source_file": "QM_Chapter6_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C6-042",
      "section_id": "6.2.2",
      "front": "Golden rule context",
