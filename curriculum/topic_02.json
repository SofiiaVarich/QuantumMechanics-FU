      "id": "c2-born-rule",
      "name": "Born rule",
      "name_de": "Bornsche Regel",
      "equation": "P(a) = ⟨ψ|Pₐ|ψ⟩",
      "symbols": {
        "Pₐ": "projector onto outcome a",
        "|ψ⟩": "normalized state"
      },
      "when_to_use": "To calculate the probability of a projective measurement outcome.",
      "assumptions": [
        "The state is normalized.",
        "The measurement is projective."
      ],
      "common_mistakes": [
        "Not taking the absolute square.",
        "Ignoring degeneracy."
      ]
    },
    {
      "id": "c2-uncertainty",
      "name": "Robertson uncertainty relation",
      "name_de": "Robertsonsche Unschärferelation",
      "equation": "ΔA ΔB ≥ ½ |⟨[A,B]⟩|",
      "symbols": {
        "ΔA": "standard deviation of A",
        "[A,B]": "commutator AB − BA"
      },
      "when_to_use": "To bound simultaneous uncertainties of two observables.",
      "assumptions": [
        "The variances exist."
      ],
      "common_mistakes": [
        "Treating uncertainty as measurement-device error."
      ]
    }
