  "concepts": [
    {
      "id": "C9-001",
      "section_id": "9.1",
      "front": "Absolute randomness",
      "definition": "The chapter asks whether underlying local hidden variables could explain outcomes.",
      "key_rule": "Quantum measurement outcomes are presented as intrinsically random.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-002",
      "section_id": "9.1",
      "front": "Experimental testability of local hidden variables",
      "definition": "A violation rules out the specified class of local models.",
      "key_rule": "Bell inequalities make the local-hidden-variable hypothesis experimentally testable.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-003",
      "section_id": "9.2",
      "front": "EPR argument",
      "definition": "The lecture traces the foundations debate to EPR.",
      "key_rule": "Einstein–Podolsky–Rosen paper (1935): the completeness of quantum mechanics.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-004",
      "section_id": "9.2",
      "front": "Entangled state",
      "definition": "The lecture emphasizes entanglement as the departure from classical intuition.",
      "key_rule": "Schrödinger introduced the term entangled state (verschränkter Zustand) in 1935.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-005",
      "section_id": "9.2",
      "front": "Bohm spin reformulation",
      "definition": "Makes the relevant correlations precise and transparent.",
      "key_rule": "Spin systems (qubits) replace the singular continuous-variable EPR setup.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-006",
      "section_id": "9.2",
      "front": "Bell’s 1964 contribution",
      "definition": "Converts a foundational question into an empirical test.",
      "key_rule": "Explicit assumptions imply experimentally falsifiable inequalities.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-007",
      "section_id": "9.3.1",
      "front": "Bipartite Bell scenario",
      "definition": "Each party performs a local measurement on a subsystem from a common source.",
      "key_rule": "Two separated parties: Alice and Bob.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-008",
      "section_id": "9.3.1",
      "front": "Conditional joint probability",
      "definition": "Probability of outcomes a₁ and b₂ given settings A₁ and B₂.",
      "key_rule": "P(a₁,b₂ | A₁,B₂)",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-009",
      "section_id": "9.3.1",
      "front": "Correlation table",
      "definition": "Collection of experimentally observed joint probabilities.",
      "key_rule": "{P(a,b | A,B)} over all settings and outcomes",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-010",
      "section_id": "9.3.1",
      "front": "Two-setting, two-outcome scenario",
      "definition": "Simplified CHSH experimental setup.",
      "key_rule": "A∈{A₁,A₂}, B∈{B₁,B₂}; a,b∈{−1,+1}",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-011",
      "section_id": "9.3.2",
      "front": "Nonnegative probabilities",
      "definition": "All joint probabilities are nonnegative.",
      "key_rule": "P(a,b | A,B) ≥ 0",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-012",
      "section_id": "9.3.2",
      "front": "Probability normalization",
      "definition": "Joint probabilities sum to one for each setting pair.",
      "key_rule": "Σₐ,ᵦ₌±₁ P(a,b | A,B) = 1",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-013",
      "section_id": "9.3.2",
      "front": "Alice’s marginal probability",
      "definition": "Bob’s outcome is summed out.",
      "key_rule": "P(a | A,B) := Σᵦ₌±₁ P(a,b | A,B)",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-014",
      "section_id": "9.3.2",
      "front": "No-signalling condition",
      "definition": "Alice’s marginal cannot depend on Bob’s choice; analogously for Bob.",
      "key_rule": "Σᵦ P(a,b | A,B) = P(a | A), independent of B",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-015",
      "section_id": "9.3.2",
      "front": "Relativistic motivation for no-signalling",
      "definition": "Explains why the no-signalling constraint is imposed.",
      "key_rule": "No controllable faster-than-light communication through measurement choices.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-016",
      "section_id": "9.3.3",
      "front": "Hidden-variable space",
      "definition": "A hidden variable may be complicated or inaccessible to measurement.",
      "key_rule": "λ ∈ Λ",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-017",
      "section_id": "9.3.3",
      "front": "Local response probability",
      "definition": "Probability of local outcome a for setting A and hidden variable λ.",
      "key_rule": "χ_A(a,λ)",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-018",
      "section_id": "9.3.3",
      "front": "Hidden-variable distribution",
      "definition": "Weights the hidden-variable realizations.",
      "key_rule": "f(λ), a probability distribution over Λ",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-019",
      "section_id": "9.3.3",
      "front": "Local hidden-variable factorization",
      "definition": "Local responses factorize conditioned on λ.",
      "key_rule": "P(a,b | A,B) = ∫dλ f(λ) χ_A(a,λ) χ_B(b,λ)",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-020",
      "section_id": "9.3.3",
      "front": "Probabilistic local hidden-variable model",
      "definition": "The lecture explicitly allows probabilistic hidden-variable models.",
      "key_rule": "Response functions may be stochastic, not only deterministic.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-021",
      "section_id": "9.4",
      "front": "Local conditional mean",
      "definition": "Mean value of a ±1 outcome given λ.",
      "key_rule": "â(λ) := χ_A(+1,λ) − χ_A(−1,λ)",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-022",
      "section_id": "9.4",
      "front": "Conditional mean bounds",
      "definition": "Response-function means lie in the interval [−1,1].",
      "key_rule": "−1 ≤ â(λ), b̂(λ) ≤ 1",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-023",
      "section_id": "9.4",
      "front": "Normalized CHSH expression",
      "definition": "Half-scaled CHSH combination at fixed λ.",
      "key_rule": "B(λ) := ½[â₁(b̂₁+b̂₂)+â₂(b̂₁−b̂₂)]",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-024",
      "section_id": "9.4",
      "front": "Pointwise local bound",
      "definition": "Bound on the half-scaled expression for every hidden variable.",
      "key_rule": "|B(λ)| ≤ 1",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-025",
      "section_id": "9.4",
      "front": "Extremal contradiction",
      "definition": "Lecture’s illustration that the algebraic maximum cannot occur.",
      "key_rule": "â₁=b̂₁=b̂₂=â₂=−b̂₂ is impossible",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-026",
      "section_id": "9.4",
      "front": "Averaged CHSH parameter",
      "definition": "Hidden-variable average of the normalized CHSH expression.",
      "key_rule": "β := ∫dλ f(λ) B(λ)",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-027",
      "section_id": "9.4",
      "front": "Normalized Bell bound",
      "definition": "Bound applies to the normalized, half-scaled CHSH expression.",
      "key_rule": "|β| ≤ 1",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-028",
      "section_id": "9.4",
      "front": "Two-party correlator",
      "definition": "Expectation value of the product of the two outcomes.",
      "key_rule": "E(A,B) := Σₐ,ᵦ₌±₁ ab P(a,b | A,B)",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-029",
      "section_id": "9.4",
      "front": "Standard CHSH inequality",
      "definition": "IMPORTANT: source prints ≤1, but its own normalized β definition implies ≤2 for this unscaled sum.",
      "key_rule": "|E(A₁,B₁)+E(A₁,B₂)+E(A₂,B₁)−E(A₂,B₂)| ≤ 2",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-030",
      "section_id": "9.4",
      "front": "Source CHSH bound typo",
      "definition": "Likely factor-of-two typo; distinguish from |β|≤1 in (9.12).",
      "key_rule": "Source (9.14) prints ≤1 for the unscaled correlator sum.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-031",
      "section_id": "9.4",
      "front": "Experimental correlator estimation",
      "definition": "Observable correlations test local-hidden-variable assumptions.",
      "key_rule": "Estimate E(A,B) from repeated runs at each settings pair.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-032",
      "section_id": "9.5",
      "front": "Quantum violation of Bell inequalities",
      "definition": "The chapter ends by asserting violation, without a worked quantum example.",
      "key_rule": "Quantum mechanics predicts violations of the local CHSH bound.",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C9-033",
      "section_id": "9.5",
      "front": "Implication of CHSH violation",
      "definition": "The conclusion depends on the assumptions of the Bell scenario.",
      "key_rule": "Correlations violating CHSH cannot be reproduced by the local hidden-variable model (9.6).",
      "source_status": "Not started",
      "source_file": "QM_Chapter9_Concept_Learning_Cards.xlsx"
    }
  ],
