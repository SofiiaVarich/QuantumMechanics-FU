      "name": "Planck–Einstein relation",
      "name_de": "Planck–Einstein-Beziehung",
      "equation": "E = hν = ℏω",
      "symbols": {
        "E": "photon energy",
        "ν": "frequency",
        "ω": "angular frequency"
      },
      "when_to_use": "To calculate the energy carried by a photon from its frequency.",
      "assumptions": [
        "The electromagnetic excitation is treated as a photon."
      ],
      "common_mistakes": [
        "Mixing ordinary frequency ν with angular frequency ω."
      ]
    },
    {
      "id": "c1-wien",
      "name": "Wien displacement law",
      "name_de": "Wiensches Verschiebungsgesetz",
      "equation": "λₘₐₓT = b",
      "symbols": {
        "λₘₐₓ": "peak wavelength",
        "T": "absolute temperature",
        "b": "Wien displacement constant"
      },
      "when_to_use": "To relate a blackbody's temperature to the wavelength where its spectrum peaks.",
      "assumptions": [
        "Ideal blackbody spectrum",
        "Temperature in kelvin"
      ],
      "common_mistakes": [
        "Confusing the spectral peak with total emitted power"
      ]
    }
