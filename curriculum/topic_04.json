  "concepts": [
    {
      "id": "C4-001",
      "section_id": "4.1",
      "front": "Classical mixture",
      "definition": "Preparation of |0⟩ or |1⟩ with probability 1/2 each; not equivalent to coherent superposition |+⟩.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-002",
      "section_id": "4.1",
      "front": "Ensemble probabilities",
      "definition": "p_j ≥ 0 and Σ(j=1…n) p_j = 1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-003",
      "section_id": "4.1",
      "front": "Mixed ensemble",
      "definition": "Classical random preparation of normalized pure states |ψ_j⟩ with probabilities p_j.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-004",
      "section_id": "4.2.1",
      "front": "Trace of an operator",
      "definition": "tr(A) = Σ(j=0…d−1) ⟨j|A|j⟩.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-005",
      "section_id": "4.2.1",
      "front": "Unitary invariance of trace",
      "definition": "tr(UAU†) = tr(A). The trace is basis-independent.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-006",
      "section_id": "4.2.1",
      "front": "Cyclic property of trace",
      "definition": "tr(AB) = tr(BA). Note: the PDF appears to repeat AB on both sides in Eq. (4.8).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-007",
      "section_id": "4.2.1",
      "front": "Additivity of trace",
      "definition": "tr(A+B) = tr(A) + tr(B).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-008",
      "section_id": "4.2.1",
      "front": "Complex conjugation of trace",
      "definition": "tr(A*) = tr(A)*.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-009",
      "section_id": "4.2.1",
      "front": "Transpose invariance of trace",
      "definition": "tr(Aᵀ) = tr(A).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-010",
      "section_id": "4.2.1",
      "front": "Scalar linearity of trace",
      "definition": "tr(αA) = α tr(A), α ∈ ℂ.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-011",
      "section_id": "4.2.2",
      "front": "Pure-state density operator",
      "definition": "ρ = |ψ⟩⟨ψ| for normalized |ψ⟩.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-012",
      "section_id": "4.2.2",
      "front": "Hermiticity of a pure-state density operator",
      "definition": "ρ = ρ†.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-013",
      "section_id": "4.2.2",
      "front": "Normalization of density operator",
      "definition": "tr(ρ) = 1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-014",
      "section_id": "4.2.2",
      "front": "Positivity of density operator",
      "definition": "ρ ≥ 0; all eigenvalues are nonnegative.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-015",
      "section_id": "4.2.2",
      "front": "Purity of a pure state",
      "definition": "tr(ρ²) = 1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-016",
      "section_id": "4.2.2",
      "front": "Expectation value via trace",
      "definition": "⟨A⟩ = ⟨ψ|A|ψ⟩ = tr(Aρ).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-017",
      "section_id": "4.2.3",
      "front": "Density operator of a mixed ensemble",
      "definition": "ρ = Σ(j=1…n) p_j |ψ_j⟩⟨ψ_j|.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-018",
      "section_id": "4.2.3",
      "front": "Ensemble-averaged expectation value",
      "definition": "⟨A⟩ = Σ_j p_j ⟨ψ_j|A|ψ_j⟩ = tr(Aρ).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-019",
      "section_id": "4.2.3",
      "front": "General density-operator conditions",
      "definition": "ρ = ρ†, ρ ≥ 0, tr(ρ) = 1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-020",
      "section_id": "4.2.3",
      "front": "Purity criterion",
      "definition": "Pure iff tr(ρ²) = 1; mixed if tr(ρ²) < 1. The script’s Eq. (4.31) prints tr(ρ)=1, apparently a typo.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-021",
      "section_id": "4.2.3",
      "front": "Mixed-state purity bound",
      "definition": "tr(ρ²) ≤ 1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-022",
      "section_id": "4.2.3",
      "front": "Observable expectation for general states",
      "definition": "⟨A⟩ = tr(Aρ).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-023",
      "section_id": "4.2.4",
      "front": "Equal mixture of computational basis states",
      "definition": "ρ = (|0⟩⟨0| + |1⟩⟨1|)/2 = I/2.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-024",
      "section_id": "4.2.4",
      "front": "Purity of maximally mixed qubit",
      "definition": "For ρ = I/2, tr(ρ²) = 1/2.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-025",
      "section_id": "4.2.4",
      "front": "Pure |0⟩ density matrix",
      "definition": "ρ = |0⟩⟨0| = [[1,0],[0,0]].",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-026",
      "section_id": "4.2.4",
      "front": "Diagonal qubit mixture",
      "definition": "ρ = [[p₀,0],[0,p₁]] with p₀+p₁=1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-027",
      "section_id": "4.2.4",
      "front": "Equal mixture in X basis",
      "definition": "(|+⟩⟨+| + |−⟩⟨−|)/2 = I/2.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-028",
      "section_id": "4.2.5",
      "front": "Non-unique ensemble decomposition",
      "definition": "Different ensembles Σ_j p_j|ψ_j⟩⟨ψ_j| and Σ_k q_k|φ_k⟩⟨φ_k| can define the same ρ.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-029",
      "section_id": "4.2.5",
      "front": "Operational equivalence of ensembles",
      "definition": "Equal density operators give equal observable expectations: ⟨A⟩ = tr(Aρ).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-030",
      "section_id": "4.2.5",
      "front": "Preferred ensemble fallacy",
      "definition": "A density operator generally does not single out one privileged underlying pure-state ensemble.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-031",
      "section_id": "4.3",
      "front": "Von Neumann equation",
      "definition": "iℏ dρ(t)/dt = [H,ρ(t)].",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-032",
      "section_id": "4.3",
      "front": "Hamiltonian commutator",
      "definition": "[H,ρ] = Hρ − ρH.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-033",
      "section_id": "4.3",
      "front": "Unitary evolution of density operator",
      "definition": "ρ(t) = U(t,t₀) ρ(t₀) U(t,t₀)†.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-034",
      "section_id": "4.4",
      "front": "Spectral decomposition of observable",
      "definition": "A = Σ(k=0…D−1) λ_k π_k.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-035",
      "section_id": "4.4",
      "front": "Orthogonal projectors",
      "definition": "π_l π_k = δ_{k,l} π_k.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-036",
      "section_id": "4.4",
      "front": "Born rule for density operators",
      "definition": "p_k = tr(π_k ρ).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-037",
      "section_id": "4.4",
      "front": "Post-measurement density operator",
      "definition": "ρ_k = π_k ρ π_k / p_k, for p_k > 0.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-038",
      "section_id": "4.5.1",
      "front": "Convex mixing of states",
      "definition": "ρ = pρ₁ + (1−p)ρ₂, with 0 ≤ p ≤ 1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-039",
      "section_id": "4.5.1",
      "front": "Mixing orthogonal pure states",
      "definition": "ρ = p|0⟩⟨0| + (1−p)|1⟩⟨1|; mixed for 0 < p < 1.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-040",
      "section_id": "4.5.1",
      "front": "Maximally mixed qubit",
      "definition": "ρ = (|0⟩⟨0| + |1⟩⟨1|)/2 = I/2.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-041",
      "section_id": "4.5.2",
      "front": "Composite Hilbert space",
      "definition": "ℋ = ℋ_A ⊗ ℋ_B.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-042",
      "section_id": "4.5.2",
      "front": "Partial trace",
      "definition": "ρ_A = tr_B(ρ) = Σ_j (I_A⊗⟨j|)ρ(I_A⊗|j⟩).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-043",
      "section_id": "4.5.2",
      "front": "Reduced state",
      "definition": "ρ_A = tr_B(ρ) is the state of subsystem A after disregarding B.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-044",
      "section_id": "4.5.2",
      "front": "Local observable",
      "definition": "A⊗I acts on subsystem A and leaves B unchanged.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-045",
      "section_id": "4.5.2",
      "front": "Local expectation via reduced state",
      "definition": "tr((A⊗I)ρ) = tr(Aρ_A).",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-046",
      "section_id": "4.5.3",
      "front": "Product density operator",
      "definition": "ρ = ρ_A ⊗ ρ_B.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-047",
      "section_id": "4.5.3",
      "front": "Partial trace of product state",
      "definition": "tr_B(ρ_A⊗ρ_B) = ρ_A.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-048",
      "section_id": "4.5.3",
      "front": "Entangled Bell-like state",
      "definition": "|ψ⟩ = (|0,0⟩ + |1,1⟩)/√2.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-049",
      "section_id": "4.5.3",
      "front": "Reduced state of Bell-like state",
      "definition": "ρ_A = (|0⟩⟨0| + |1⟩⟨1|)/2 = I/2.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C4-050",
      "section_id": "4.5.3",
      "front": "Entangled pure state",
      "definition": "A pure composite state that is not a product state; its reduced states are mixed.",
      "key_rule": "",
      "source_status": "Not started",
      "source_file": "QM_Chapter4_Concept_Learning_Cards.xlsx"
    }
  ],
