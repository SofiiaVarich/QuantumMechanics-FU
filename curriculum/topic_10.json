      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-043",
      "section_id": "10.3.1",
      "front": "Ground-state variational principle",
      "definition": "Ground state minimizes expected energy.",
      "key_rule": "min_{⟨ψ|ψ⟩=1} ⟨ψ|H|ψ⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-044",
      "section_id": "10.3.2",
      "front": "Optical lattice",
      "definition": "Cold atoms can be confined near lattice minima.",
      "key_rule": "Standing laser-wave potential",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-045",
      "section_id": "10.3.2",
      "front": "On-site Fock states",
      "definition": "Occupancy of zero, one, or k bosons at a site.",
