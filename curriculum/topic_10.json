      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-037",
      "section_id": "10.2.1",
      "front": "Hydrogen-like energy scaling",
      "definition": "Energy scales as −Z²/n² in this idealized model.",
      "key_rule": "Eₙ = −mZ²e₀⁴/(2ℏ²n²)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-038",
      "section_id": "10.2.1",
      "front": "Alkali atom approximation",
      "definition": "The lecture uses this simplified description; real alkali atoms have core-electron effects.",
      "key_rule": "Single-electron hydrogen-like discussion",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-039",
      "section_id": "10.2.2",
      "front": "Helium atom",
      "definition": "Lecture states that a full treatment is beyond this course.",
      "key_rule": "Two-electron atomic problem",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-040",
      "section_id": "10.3.1",
      "front": "Quantum many-body system",
      "definition": "Interactions make independent-subsystem descriptions insufficient.",
