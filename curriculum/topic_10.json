      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-030",
      "section_id": "10.1.4",
      "front": "Closed-system commutator term",
      "definition": "Printed in the lecture with ℏ suppressed.",
      "key_rule": "∂tρS = −i[HS,ρS]",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-031",
      "section_id": "10.1.4",
      "front": "Harmonic-oscillator Hamiltonian",
      "definition": "Reference oscillator for damping example.",
      "key_rule": "HS = ℏω(a†a + ½)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-032",
      "section_id": "10.1.4",
      "front": "Damping operator",
      "definition": "Single Lindblad operator proportional to annihilation operator.",
      "key_rule": "L = √c a, c>0",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-033",
      "section_id": "10.1.4",
      "front": "Excited initial state",
      "definition": "One excitation initially.",
      "key_rule": "ρS(t₀) = |1⟩⟨1|",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-034",
      "section_id": "10.1.4",
      "front": "Exponential relaxation",
      "definition": "Excitation decays into the ground state at rate c.",
      "key_rule": "ρS(t) = e^(−cΔt)|1⟩⟨1| + (1−e^(−cΔt))|0⟩⟨0|",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-035",
      "section_id": "10.1.4",
      "front": "Long-time stationary state",
      "definition": "Ground state remains after relaxation.",
      "key_rule": "lim(t→∞) ρS(t) = |0⟩⟨0|",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-036",
      "section_id": "10.2.1",
      "front": "Nuclear Coulomb potential",
      "definition": "Lecture extends hydrogen-like Coulomb model to nuclear charge Z.",
