      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-046",
      "section_id": "10.3.2",
      "front": "Bose–Hubbard Hamiltonian",
      "definition": "Hopping, on-site interaction, and chemical-potential terms.",
      "key_rule": "H = −JΣⱼ(bⱼ†bⱼ₊₁+bⱼ₊₁†bⱼ) + (U/2)Σⱼ nⱼ(nⱼ−1) − μΣⱼ nⱼ",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-047",
      "section_id": "10.3.2",
      "front": "Boson number operator",
      "definition": "Counts particles at lattice site j.",
      "key_rule": "nⱼ = bⱼ†bⱼ",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-048",
      "section_id": "10.3.2",
      "front": "Hopping operator",
      "definition": "Moves a boson from site j+1 to j.",
      "key_rule": "bⱼ†bⱼ₊₁",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-049",
      "section_id": "10.3.2",
      "front": "On-site interaction",
      "definition": "Interaction contribution for multiple bosons on a site.",
      "key_rule": "nⱼ(nⱼ−1)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-050",
      "section_id": "10.3.2",
      "front": "Quantum phase transition",
      "definition": "Zero-temperature change in the ground-state phase.",
      "key_rule": "H(g)=H₀+gV; nonanalytic ground-state energy at g₀",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-051",
      "section_id": "10.3.2",
      "front": "Superfluid phase",
      "definition": "One of the two phases described in the lecture.",
      "key_rule": "Delocalized, strongly correlated ground state",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-052",
      "section_id": "10.3.2",
      "front": "Mott-insulator phase",
      "definition": "Deep Mott phase has fixed integer filling and product-state form.",
      "key_rule": "|ψ⟩ = |k,k,…,k⟩",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-053",
      "section_id": "10.3.3",
      "front": "Mean-field approximation",
      "definition": "Reduces interacting lattice problem to effective single-site problems.",
      "key_rule": "Neighbor interactions replaced by average influence",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-054",
      "section_id": "10.3.3",
      "front": "Superfluid order parameter",
      "definition": "Translation-invariant mean-field parameter; assumes real ψ.",
      "key_rule": "ψ = ⟨bⱼ†⟩ = ⟨bⱼ⟩ (as printed)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-055",
      "section_id": "10.3.3",
      "front": "Mean-field decoupling",
      "definition": "Neglects quadratic fluctuations around mean fields.",
      "key_rule": "bᵢ†bⱼ ≈ ⟨bᵢ†⟩bⱼ + bᵢ†⟨bⱼ⟩ − ⟨bᵢ†⟩⟨bⱼ⟩",
