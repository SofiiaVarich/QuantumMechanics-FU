      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-041",
      "section_id": "10.3.1",
      "front": "Lattice model",
      "definition": "Examples include spins and oscillator modes.",
      "key_rule": "Degrees of freedom at lattice vertices",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-042",
      "section_id": "10.3.1",
      "front": "k-local Hamiltonian",
      "definition": "Each Hⱼ acts on at most k sites, often neighboring pairs.",
