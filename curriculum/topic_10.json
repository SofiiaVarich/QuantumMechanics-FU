    {
      "id": "C10-001",
      "section_id": "10.1.1",
      "front": "Open quantum system",
      "definition": "The subsystem is described by its reduced density operator.",
      "key_rule": "System S interacts with environment E",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-002",
      "section_id": "10.1.1",
      "front": "System and environment Hilbert spaces",
      "definition": "Joint Hilbert space is a tensor product.",
      "key_rule": "ℋ = ℋS ⊗ ℋE",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-003",
      "section_id": "10.1.1",
      "front": "Total Hamiltonian",
      "definition": "Free system, free environment, and interaction terms.",
      "key_rule": "H = HS ⊗ I + I ⊗ HE + HI",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-004",
      "section_id": "10.1.1",
      "front": "Joint density-operator evolution",
      "definition": "Joint system evolves unitarily.",
      "key_rule": "ρ(t) = U(t,t₀)ρ(t₀)U(t,t₀)†",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-005",
      "section_id": "10.1.1",
      "front": "Unitary time evolution",
      "definition": "Time-independent total Hamiltonian.",
      "key_rule": "U(t,t₀) = exp[−i(t−t₀)H/ℏ]",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-006",
      "section_id": "10.1.1",
      "front": "Initially uncorrelated state",
      "definition": "Product initial state is an assumption, not always physically justified.",
      "key_rule": "ρ(t₀) = ρS(t₀) ⊗ ρE(t₀)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-007",
      "section_id": "10.1.1",
      "front": "Reduced system state",
      "definition": "Trace out environmental degrees of freedom.",
      "key_rule": "ρS(t) = trE[ρ(t)]",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-008",
      "section_id": "10.1.1",
      "front": "Reduced system dynamics",
      "definition": "Open dynamics can be nonunitary even though the joint evolution is unitary.",
      "key_rule": "ρS(t) = trE[U(ρS(t₀)⊗ρE(t₀))U†]",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-009",
      "section_id": "10.1.2",
      "front": "Decoherence",
      "definition": "Coupling and entanglement with the environment suppress coherent quantum features.",
      "key_rule": "Pure subsystem → mixed reduced state",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-010",
      "section_id": "10.1.2",
      "front": "Example free Hamiltonians",
      "definition": "The example retains only the interaction.",
      "key_rule": "HS = 0; HE = 0",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-011",
      "section_id": "10.1.2",
      "front": "Example interaction Hamiltonian",
      "definition": "Two-qubit system–environment interaction.",
      "key_rule": "HI = σx ⊗ σx",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-012",
      "section_id": "10.1.2",
      "front": "Initial environment state",
      "definition": "Environment starts in a pure computational-basis state.",
      "key_rule": "ρE(t₀) = |0⟩⟨0|",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-013",
      "section_id": "10.1.2",
      "front": "Initial plus state",
      "definition": "First scenario in the lecture.",
      "key_rule": "ρS(t₀) = |+⟩⟨+|",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-014",
      "section_id": "10.1.2",
      "front": "Initial computational state",
      "definition": "Second scenario in the lecture.",
      "key_rule": "ρS(t₀) = |0⟩⟨0|",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-015",
      "section_id": "10.1.2",
      "front": "Example evolution time",
      "definition": "Chosen time for the lecture example.",
      "key_rule": "t−t₀ = πℏ/4",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-016",
      "section_id": "10.1.2",
      "front": "Maximally mixed qubit",
      "definition": "Reduced state claimed in the example; see source caution in Study Guide.",
      "key_rule": "ρS = ½(|0⟩⟨0| + |1⟩⟨1|) = I/2",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-017",
      "section_id": "10.1.2",
      "front": "Loss of coherence",
      "definition": "Off-diagonal coherences disappear in the chosen basis.",
      "key_rule": "α|0⟩+β|1⟩ → |α|²|0⟩⟨0|+|β|²|1⟩⟨1|",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-018",
      "section_id": "10.1.2",
      "front": "Decoherence without dissipation",
      "definition": "The lecture distinguishes coherence loss from energy dissipation.",
      "key_rule": "Loss of interference need not imply large energy transfer",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-019",
      "section_id": "10.1.3",
      "front": "Quantum state transformation",
      "definition": "Abstract operation mapping density operators to density operators.",
      "key_rule": "ρ ↦ T(ρ)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-020",
      "section_id": "10.1.3",
      "front": "Positive map",
      "definition": "Positivity alone is insufficient for arbitrary entangled extensions.",
      "key_rule": "T maps positive operators to positive operators",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-021",
      "section_id": "10.1.3",
      "front": "Complete positivity",
      "definition": "Physical channels remain positive on entangled extensions.",
      "key_rule": "T ⊗ I is positive for arbitrary ancillas",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-022",
      "section_id": "10.1.3",
      "front": "Quantum channel",
      "definition": "Lecture presents channels as completely positive maps; see normalization note.",
      "key_rule": "ρ ↦ T(ρ)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-023",
      "section_id": "10.1.3",
      "front": "Operator-sum representation",
      "definition": "Kraus representation of a channel.",
      "key_rule": "T(ρ) = Σⱼ AⱼρAⱼ†",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-024",
      "section_id": "10.1.3",
      "front": "Unitary channel",
      "definition": "A unitary operation is a single-term operator-sum map.",
      "key_rule": "A₁ = U(t,t₀)",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-025",
      "section_id": "10.1.3",
      "front": "Measurement operators",
      "definition": "Projectors give an example of the operator-sum form for nonselective measurement.",
      "key_rule": "Aⱼ = πⱼ",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-026",
      "section_id": "10.1.3",
      "front": "Channel construction",
      "definition": "Operational picture described in the lecture.",
      "key_rule": "Append environment → unitary evolution → partial trace",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-027",
      "section_id": "10.1.4",
      "front": "Markovian evolution",
      "definition": "The lecture calls this forgetful noise.",
      "key_rule": "Dynamics depends on present state, not full history",
      "source_status": "Not started",
      "source_file": "QM_Chapter10_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C10-028",
      "section_id": "10.1.4",
      "front": "Master equation",
