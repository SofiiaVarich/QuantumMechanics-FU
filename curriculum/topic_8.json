  "concepts": [
    {
      "id": "C8-001",
      "section_id": "8.1",
      "front": "Charged-particle Hamiltonian",
      "definition": "Minimal coupling of a spinless charged particle to vector and scalar potentials.",
      "key_rule": "H = (P − eA/c)²/(2m) + eΦ",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-002",
      "section_id": "8.1",
      "front": "Position-space Schrödinger equation",
      "definition": "Time evolution of the charged particle in electromagnetic potentials.",
      "key_rule": "iℏ ∂ψ/∂t = [(−iℏ∇ − eA/c)²/(2m) + eΦ]ψ",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-003",
      "section_id": "8.1",
      "front": "Coulomb gauge",
      "definition": "Gauge condition used to simplify the kinetic cross term.",
      "key_rule": "∇·A = 0",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-004",
      "section_id": "8.1",
      "front": "Expanded Hamiltonian in Coulomb gauge",
      "definition": "Separates free motion, magnetic cross term, quadratic magnetic term, and electric potential.",
      "key_rule": "iℏ∂ₜψ = −ℏ²∇²ψ/(2m) + (iℏe/mc) A·∇ψ + e²A²ψ/(2mc²) + eΦψ",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-005",
      "section_id": "8.1",
      "front": "Vector potential",
      "definition": "Magnetic field is represented by the curl of the vector potential.",
      "key_rule": "B = ∇×A",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-006",
      "section_id": "8.1",
      "front": "Scalar potential",
      "definition": "Electric potential energy term for charge e.",
      "key_rule": "eΦ",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-007",
      "section_id": "8.2.1",
      "front": "Uniform-field vector potential",
      "definition": "A vector potential producing a constant magnetic field.",
      "key_rule": "A = −½(x×B)",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-008",
      "section_id": "8.2.1",
      "front": "Orbital magnetic coupling",
      "definition": "Term linear in B associated with orbital paramagnetism.",
      "key_rule": "−(e/2mc)L·B",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-009",
      "section_id": "8.2.1",
      "front": "Diamagnetic contribution",
      "definition": "Term quadratic in B; often small in the atomic setting described.",
      "key_rule": "e²/(8mc²)[x²B² − (x·B)²]",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-010",
      "section_id": "8.2.1",
      "front": "Paramagnetic term",
      "definition": "Contribution associated with the orbital angular momentum.",
      "key_rule": "∝ L·B",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-011",
      "section_id": "8.2.1",
      "front": "Diamagnetic term",
      "definition": "Contribution quadratic in the magnetic field.",
      "key_rule": "∝ B²",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-012",
      "section_id": "8.2.2",
      "front": "Normal Zeeman Hamiltonian",
      "definition": "Linear Zeeman Hamiltonian in Gaussian units for a z-directed field; e is the signed electron charge and the quadratic magnetic term is neglected.",
      "key_rule": "H = H⁽⁰⁾ − (eB/2mc)L₃",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-013",
      "section_id": "8.2.2",
      "front": "Normal Zeeman energy levels",
      "definition": "Magnetic quantum number determines the splitting.",
      "key_rule": "Eₙₗₘ = −me₀⁴/(2ℏ²n²) + ℏωL m",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-014",
      "section_id": "8.2.2",
      "front": "Larmor frequency",
      "definition": "Larmor frequency as written in the lecture; e is the signed electron charge.",
      "key_rule": "ωL = −eB/(2mc) = e₀B/(2mc)",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-015",
      "section_id": "8.2.2",
      "front": "Zeeman splitting multiplicity",
      "definition": "Magnetic field lifts the m-degeneracy in the normal Zeeman effect.",
      "key_rule": "2l + 1 equally spaced levels",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-016",
      "section_id": "8.2.2",
      "front": "Magnetic quantum number",
      "definition": "Allowed z-projection quantum numbers.",
      "key_rule": "m = −l, −l+1, …, l",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-017",
      "section_id": "8.2.3",
      "front": "Total angular momentum",
      "definition": "Spin–orbit coupling combines orbital and spin angular momenta.",
      "key_rule": "J = L + S",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-018",
      "section_id": "8.2.3",
      "front": "Spin-inclusive magnetic Hamiltonian",
      "definition": "Magnetic coupling includes orbital and spin contributions.",
      "key_rule": "H = H⁽⁰⁾ − [e/(2mc)](L+gS)·B",
      "source_status": "Not started",
      "source_file": "QM_Chapter8_Concept_Learning_Cards.xlsx"
    },
    {
      "id": "C8-019",
      "section_id": "8.2.3",
